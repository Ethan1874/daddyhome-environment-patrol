# DingTalk application configuration. Never commit real values.
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_CORP_ID=
DINGTALK_OPERATOR_ID=

# Generate a separate high-entropy value (at least 32 characters) for signing 90-day sessions.
PATROL_SESSION_SECRET=

# Required only for the manual staff-directory login/switch flow.
TEACHER_PASSCODE=

# Cloudflare production also requires an R2 binding named PATROL_UPLOADS.
